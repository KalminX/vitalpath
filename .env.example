# Django Settings
SECRET_KEY=django-insecure-vitalpath-demo-key-change-in-production-2026-secure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave blank or unset for local SQLite fallback, or provide postgres://user:pass@host:port/dbname)
DATABASE_URL=

# Stripe Settings (Test Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_sample_vitalpath_education_key_12345
STRIPE_SECRET_KEY=sk_test_sample_vitalpath_education_secret_67890
STRIPE_WEBHOOK_SECRET=whsec_sample_vitalpath_webhook_secret_abcde
STRIPE_CURRENCY=usd

# Site & Domain
SITE_URL=http://127.0.0.1:8000
SITE_NAME=VitalPath Education

# Email Backend Configuration
# For local development, 'console' prints emails to stdout or 'file' writes to storage
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VitalPath Education <hello@vitalpath.edu>
NOTIFICATION_EMAIL=creator@vitalpath.edu

# Security (Set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
